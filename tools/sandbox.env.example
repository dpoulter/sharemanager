# Copy to tools/sandbox.env and fill in. That file is gitignored; this one is
# the template. Real environment variables override whatever is set here.
SM_SANDBOX_DB=sharemanager_sandbox
# localhost uses the unix socket and matches an account created as
# 'user'@'localhost'. 127.0.0.1 is a TCP connection and may not match it.
SM_SANDBOX_HOST=localhost
SM_SANDBOX_USER=sandbox
SM_SANDBOX_PASS=change-me
