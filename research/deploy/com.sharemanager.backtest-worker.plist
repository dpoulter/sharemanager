<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The backtest worker (research/src/research/worker.py), kept running by launchd.

  Install (Jarvis): replace YOUR_USER with the Mac mini's user name, then
    cp com.sharemanager.backtest-worker.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.sharemanager.backtest-worker.plist

  The token is not here: it is in ~/.config/sharemanager-research/worker.env (mode 600).
  A worker that refuses to start (the run 9 replay check has not passed at the
  current commit) exits; launchd tries again after ThrottleInterval.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sharemanager.backtest-worker</string>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USER/sharemanager-research/research</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/uv</string>
		<string>run</string>
		<string>research</string>
		<string>worker</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/sharemanager-research/logs/worker.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/sharemanager-research/logs/worker.out</string>
</dict>
</plist>
